# Copy to .env (scripts/dev_setup.py does this for you). Never commit .env.

# Public URL of this app as the browser sees it. Must match IdP registrations exactly.
SSO_BASE_URL=http://localhost:8000
# Plain http in local dev only. Keep true (default) everywhere else.
SSO_COOKIE_SECURE=false

# Access policy (roles, permissions, org tree). Default: config/rbac.yaml
# RBAC_POLICY_FILE=config/rbac.yaml

# Local Keycloak (dev/keycloak). Dev-only value; real secrets come from a secret manager.
KC_ISSUER=http://localhost:8080/realms/sso-dev
KC_OIDC_CLIENT_SECRET=change-me-dev-oidc-secret

# Google example tenant (config/tenants.example.yaml)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
